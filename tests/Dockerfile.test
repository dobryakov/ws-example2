FROM mcr.microsoft.com/playwright:v1.56.1-jammy

WORKDIR /app

# Copy package files
COPY backend/package*.json ./backend/
COPY backend/tsconfig.json ./backend/
COPY tests/package*.json ./tests/

# Install dependencies
WORKDIR /app/backend
RUN npm install

WORKDIR /app/tests
RUN npm install

# Copy test files (only e2e tests for Playwright)
COPY tests/e2e ./tests/e2e
COPY tests/playwright.config.ts ./tests/
COPY tests/package.json ./tests/

# Run tests
CMD ["npm", "test"]

